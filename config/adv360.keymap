#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        google_drive_share: google_drive_share {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 10>,
                <&kp LEFT_CONTROL>,
                <&macro_wait_time 10>,
                <&macro_tap>,
                <&kp A>,
                <&macro_wait_time 10>,
                <&macro_release>,
                <&kp LEFT_ALT &kp LEFT_CONTROL>;

            label = "GOOGLE_DRIVE_SHARE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1        &kp N2            &kp N3         &kp N4        &kp N5  &kp LS(N3)                                                                                  &kp LS(LC(N4))  &kp N6  &kp N7    &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB    &kp Q         &kp W             &kp E          &kp R         &kp T   &to 1                                                                                       &kp EQUAL       &kp Y   &kp U     &kp I      &kp O    &kp P      &kp BSLH
&mo 1      &kp A         &kp S             &kp D          &kp F         &kp G   &kp F2      &kp INT_MUHENKAN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET  &kp INTERNATIONAL_4  &kp DEL         &kp H   &kp J     &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z         &kp X             &kp C          &kp V         &kp B                                 &kp PG_UP             &kp HOME                                                &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH   &kp RIGHT_SHIFT
&kp ESC    &kp LG(DOWN)  &kp LG(UP_ARROW)  &kp LEFT_META  &kp LEFT_ALT          &kp SPACE   &kp LCTRL         &kp PG_DN             &kp END            &kp BSPC             &kp ENTER               &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &to 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &kp F1     &kp F2    &kp F3     &kp F4             &kp F5                  &trans                                      &trans  &kp F6           &kp F7     &kp F8      &kp F9      &kp F10       &kp F11
&trans  &kp PG_UP  &kp UP    &kp PG_DN  &kp LC(PG_UP)      &kp LC(LG(LEFT_ARROW))  &to 0                                       &trans  &kp KP_DIVIDE    &kp KP_N7  &kp KP_N8   &kp KP_N9   &kp KP_MINUS  &kp F12
&none   &kp LEFT   &kp DOWN  &kp RIGHT  &kp LC(PAGE_DOWN)  &kp LC(LG(RIGHT))       &trans  &trans  &trans      &trans  &trans  &trans  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5   &kp KP_N6   &kp KP_PLUS   &kp TAB
&trans  &trans     &trans    &trans     &trans             &trans                                  &trans      &trans                  &mkp MB1         &kp KP_N1  &kp KP_N2   &kp KP_N3   &kp KP_NUM    &trans
&trans  &trans     &trans    &trans     &trans                                     &trans  &trans  &trans      &trans  &trans  &trans                   &kp KP_N0  &kp KP_DOT  &kp KP_DOT  &trans        &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&bootloader  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4  &none                                            &trans                  &none           &none           &none         &none            &none  &none
&none        &mkp MB4       &kp PAGE_DOWN  &kp LC(PG_UP)  &mkp MB5      &none         &to 0                                            &bootloader             &kp HOME        &kp PAGE_DOWN   &kp PG_UP     &kp END          &none  &none
&to 0        &kp F5         &mkp LCLK      &mkp MB3       &mkp MB2      &kp LC(W)     &none  &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&none        &kp LC(LS(T))  &none          &none          &none         &none                       &none      &none                                           &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
&none        &none          &none          &none          &none                       &none  &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                         &bl BL_INC      &bl BL_DEC    &none            &none  &to 0
            >;
        };
    };
};
